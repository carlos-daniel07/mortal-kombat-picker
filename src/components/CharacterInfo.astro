---
interface Props {
  characterName: string;
  characterDescription: string;
  id?: string;
}

const { characterDescription, characterName, id } = Astro.props;
---

<div id={id} class="absolute left-4 top-4 sm:left-8 sm:top-8 md:left-16 md:top-12 lg:left-30 lg:top-20 max-w-[48%] sm:max-w-[44%]">
  <h3
    class="text-white font-bold text-left leading-tight mb-2 md:mb-6 animated-character-title
           text-4xl sm:text-6xl md:text-7xl lg:text-[8rem] lg:leading-[7.5rem]"
  >
    {characterName}
  </h3>
  <p class="text-white text-left leading-5 sm:leading-6 text-sm sm:text-base md:text-lg animated-character-text max-w-[95%] sm:max-w-[26rem]">
    {characterDescription}
  </p>
</div>
